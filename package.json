{
  "name": "workcode",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config apps/code/vite.config.ts",
    "check": "tsc --noEmit",
    "build": "npm run check && vite build --config apps/code/vite.config.ts && node scripts/package-code.mjs",
    "preview": "vite preview --config apps/code/vite.config.ts",
    "build:code-ui": "rustc --edition=2021 --target wasm32-unknown-unknown --crate-type cdylib -C opt-level=z -C panic=abort -C strip=symbols web/src/code/ui/workbench.rs -o web/src/code/ui/workbench.wasm",
    "release:zip": "npm run build && python3 scripts/release.py"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.8",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@noble/hashes": "2.4.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "lucide-react": "1.79.0",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript-service": "npm:typescript@5.9.3"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
