{
  "id": "./",
  "name": "WorkOS Code",
  "short_name": "Code",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#182c2b",
  "icons": [
    { "src": "./icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "./icon-512.png", "sizes": "512x512", "type": "image/png" }
  ],
  "file_handlers": [{ "action": "./index.html", "accept": { "text/plain": [".txt", ".md", ".js", ".jsx", ".ts", ".tsx", ".json", ".css", ".html"] } }],
  "workos": { "version": 1, "capabilities": ["files.read", "files.write", "preferences", "share", "clipboard", "notifications"] }
}
